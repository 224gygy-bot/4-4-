<script>
"use strict";
/* ================= 탐정 훈련 모드 ================= */
/* 레벨 정의: [판 크기, 네모방 가로, 네모방 세로, 빈칸 수] */
const LEVELS=[
  {n:4,bw:2,bh:2,blanks:6},{n:4,bw:2,bh:2,blanks:8},{n:4,bw:2,bh:2,blanks:10},
  {n:6,bw:3,bh:2,blanks:10},{n:6,bw:3,bh:2,blanks:14},{n:6,bw:3,bh:2,blanks:18},
  {n:9,bw:3,bh:3,blanks:25},{n:9,bw:3,bh:3,blanks:35},{n:9,bw:3,bh:3,blanks:45}
];
const ZONES=[[1,3,"🏘️ 동네 사건"],[4,6,"🏙️ 도시 사건"],[7,9,"🌏 나라 사건"]];
let trainState={cleared:[],stars:{},legendBadge:false};
function saveTrain(){
  if(currentProfile){ // 프로필 맵에 훈련 진행도 함께 저장
    profiles[currentProfile]=profiles[currentProfile]||{};
    profiles[currentProfile].train=trainState;
    profiles[currentProfile].state=state;
    saveProfiles();
  }
  try{ localStorage.setItem("detectiveSudokuTrain",JSON.stringify(trainState)); }catch(e){} // 구 버전 호환 유지
}
function loadTrain(){ try{ const s=localStorage.getItem("detectiveSudokuTrain");
  if(s){ const t=JSON.parse(s); if(t&&Array.isArray(t.cleared)) trainState=Object.assign(trainState,t); } }catch(e){} }
let notebookReturn=null;

/* ---- 문제 자동 생성 ---- */
function shuffled(a){ const x=a.slice(); for(let i=x.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [x[i],x[j]]=[x[j],x[i]]; } return x; }
function okPlace(g,n,bw,bh,r,c,v){
  for(let i=0;i<n;i++){ if(g[r][i]===v||g[i][c]===v) return false; }
  const br=Math.floor(r/bh)*bh, bc=Math.floor(c/bw)*bw;
  for(let i=br;i<br+bh;i++) for(let j=bc;j<bc+bw;j++){ if(g[i][j]===v) return false; }
  return true;
}
function genSolution(n,bw,bh){
  const g=Array.from({length:n},()=>Array(n).fill(0));
  (function fill(pos){
    if(pos===n*n) return true;
    const r=Math.floor(pos/n), c=pos%n;
    for(const v of shuffled([...Array(n).keys()].map(i=>i+1))){
      if(okPlace(g,n,bw,bh,r,c,v)){ g[r][c]=v; if(fill(pos+1)) return true; g[r][c]=0; }
    }
    return false;
  })(0);
  return g;
}
/* 해 개수를 최대 limit개까지 세는 백트래킹 카운터 */
function countSolutions(g,n,bw,bh,limit){
  let count=0;
  (function solve(){
    if(count>=limit) return;
    let br=-1,bc=-1,best=null;
    for(let r=0;r<n;r++)for(let c=0;c<n;c++) if(!g[r][c]){
      const cand=[];
      for(let v=1;v<=n;v++) if(okPlace(g,n,bw,bh,r,c,v)) cand.push(v);
      if(cand.length===0) return;
      if(!best||cand.length<best.length){ best=cand; br=r; bc=c; }
    }
    if(best===null){ count++; return; }
    for(const v of best){ g[br][bc]=v; solve(); g[br][bc]=0; if(count>=limit) return; }
  })();
  return count;
}
function genPuzzle(n,bw,bh,blanks){
  const solution=genSolution(n,bw,bh);
  const puzzle=solution.map(r=>r.slice());
  let removed=0, guard=0;
  const cells=shuffled([...Array(n*n).keys()]);
  for(const pos of cells){
    if(removed>=blanks||guard>=n*n*4) break;
    guard++;
    const r=Math.floor(pos/n), c=pos%n;
    if(!puzzle[r][c]) continue;
    const bak=puzzle[r][c]; puzzle[r][c]=0;
    if(countSolutions(puzzle,n,bw,bh,2)!==1) puzzle[r][c]=bak; // 유일해 유지
    else removed++;
  }
  return {puzzle,solution};
}

/* ---- 레벨 지도 ---- */
function trainMap(){
  renderTop();
  let html=`<h2 class="center">🔥 탐정 훈련 모드</h2>
    ${chiefSays(state.name+" 탐정! 새로운 사건들이 기다리고 있어! 차례대로 해결해 보자!")}`;
  ZONES.forEach(([a,b,title])=>{
    html+=`<div class="map-zone"><h3 class="jua">${title}</h3>`;
    const nums=[]; for(let l=a;l<=b;l++) nums.push(l);
    html+=`<div class="lv-row${a===4?" rev":""}">`+nums.map(l=>{
      const done=trainState.cleared.includes(l), open=l===1||trainState.cleared.includes(l-1);
      const st=trainState.stars[l];
      const cls=done?"done":(open?"open":"locked");
      const inner=(done?`<span class="stampmini">✅</span>`:"")+
        `<span style="font-size:1.3rem">${done?"📂":open?"🔎":"🔒"}</span>레벨 ${l}`+
        `<span class="stars">${st?"★".repeat(st):"&nbsp;"}</span>`;
      return done||open
        ? `<button class="lv-card ${cls}" data-lv="${l}" style="min-height:88px">${inner}</button>`
        : `<div class="lv-card ${cls}" role="img" aria-label="레벨 ${l} 잠김">${inner}</div>`;
    }).join("")+`</div></div>`;
  });
  if(trainState.legendBadge) html+=`<div class="clue-card golden center pop"><b>👑 전설의 탐정!</b> 모든 사건을 해결했어!</div>`;
  html+=`<div class="toolbar">
    <button id="notebook-btn">📓 탐정 수첩</button>
    <button id="end-btn">🏠 사건 화면으로</button></div>`;
  screen.innerHTML=html;
  screen.querySelectorAll("button.lv-card").forEach(b=>b.onclick=()=>trainIntro(+b.dataset.lv));
  document.getElementById("notebook-btn").onclick=()=>{ notebookReturn="map"; openNotebook(); };
  document.getElementById("end-btn").onclick=()=>{ state.finished?ending():(state.name?missionIntro():profileScreen()); };
}

function trainIntro(lv){
  renderTop();
  const L=LEVELS[lv-1];
  let msg;
  if(lv===4) msg="이번엔 판이 더 커졌어! 네모방이 가로로 긴 직사각형(가로 3칸, 세로 2칸)이 됐어! 숫자는 1부터 6까지야!";
  else if(lv===7) msg="판이 아주 커졌어! 숫자가 1부터 9까지 늘었어! 네모방은 가로 3칸, 세로 3칸이야!";
  else msg=`레벨 ${lv} 사건이야! ${L.n}×${L.n} 판에서 빈칸 ${L.blanks}개를 채워 줘! 숫자는 1부터 ${L.n}까지야!`;
  screen.innerHTML=`<h2 class="center">레벨 ${lv} ${lv<=3?"🏘️":lv<=6?"🏙️":"🌏"}</h2>
    ${chiefSays(msg)}
    <div class="center"><button class="big-btn" id="tgo-btn">사건 시작!</button></div>
    <div class="toolbar"><button id="tmap-btn">🗺️ 지도로</button></div>`;
  document.getElementById("tgo-btn").onclick=()=>trainLoading(lv);
  document.getElementById("tmap-btn").onclick=trainMap;
}

function trainLoading(lv){
  screen.innerHTML=`<div class="loading-box"><span class="mag">🕵️</span>
    <p class="jua" style="font-size:1.2rem; margin-top:12px">사건 파일을 준비하는 중…</p></div>`;
  setTimeout(()=>trainPlay(lv),50); // 로딩 화면을 먼저 렌더링하고 생성 실행
}

/* ---- 훈련 플레이 ---- */
let tCleared=false; // 정답 연타 방지 잠금 (기존 cleared 패턴과 동일)
function trainPlay(lv){
  tCleared=false;
  renderTop();
  const L=LEVELS[lv-1], n=L.n, bw=L.bw, bh=L.bh;
  const {puzzle,solution}=genPuzzle(n,bw,bh,L.blanks);
  const given=puzzle.map(r=>r.slice());
  let sel=null, hintStage=0, hintsUsed=0, hintCell=null, wrongLock=false;

  screen.innerHTML=`<h2 class="center">레벨 ${lv} 사건 현장 ${lv<=3?"🏘️":lv<=6?"🏙️":"🌏"}</h2>
    <p class="center jua">빈칸을 누르고 숫자를 골라 봐!</p>
    <div id="board-slot"></div>
    <div id="numpad" class="wrap">${[...Array(n).keys()].map(i=>`<button data-n="${i+1}">${i+1}</button>`).join("")}
      <button data-n="0" aria-label="지우기">⌫</button></div>
    <div id="feedback" class="feedback" tabindex="-1"></div>
    <div class="center" id="next-slot"></div>
    <div class="toolbar">
      <button id="hint-btn" aria-label="돋보기 힌트">🔍</button>
      <button id="tmap-btn2">🗺️ 지도로</button></div>`;

  const board=buildBoard(puzzle);
  board.classList.add("n"+n);
  // 네모방 경계선 두껍게 (판 크기 일반화)
  board.querySelectorAll(".cell").forEach(c=>{
    const r=+c.dataset.r, cc=+c.dataset.c;
    if(puzzle[r][cc]) c.classList.add("given");
    c.style.borderLeftWidth=(cc%bw===0)?"4px":"2px";
    c.style.borderTopWidth=(r%bh===0)?"4px":"2px";
    c.style.borderRightWidth=(cc===n-1)?"4px":"2px";
    c.style.borderBottomWidth=(r===n-1)?"4px":"2px";
  });
  document.getElementById("board-slot").appendChild(board);
  const cellAt=(r,c)=>board.querySelector(`[data-r="${r}"][data-c="${c}"]`);
  const sameBox=(r1,c1,r2,c2)=>Math.floor(r1/bh)===Math.floor(r2/bh)&&Math.floor(c1/bw)===Math.floor(c2/bw);
  function refreshMarks(){
    board.querySelectorAll(".cell").forEach(c=>c.classList.remove("related","same-num"));
    if(!sel) return;
    const [r,cc]=sel;
    board.querySelectorAll(".cell").forEach(x=>{
      const rr=+x.dataset.r, cx=+x.dataset.c;
      if(rr===r||cx===cc||sameBox(rr,cx,r,cc)) x.classList.add("related");
    });
  }
  board.querySelectorAll(".cell").forEach(c=>{
    const act=()=>{
      if(tCleared) return;
      const r=+c.dataset.r, cc=+c.dataset.c;
      board.querySelectorAll(".cell").forEach(x=>x.classList.remove("selected"));
      c.classList.add("selected"); sel=[r,cc]; refreshMarks();
    };
    c.onclick=act; c.onkeydown=e=>{ if(e.key==="Enter"||e.key===" "){e.preventDefault();act();} };
  });
  function conflictWhy(r,c,v){
    for(let i=0;i<n;i++) if(i!==c&&given[r][i]===v) return `이 가로줄에 벌써 ${v}이(가) 숨어 있어!`;
    for(let i=0;i<n;i++) if(i!==r&&given[i][c]===v) return `이 세로줄에 벌써 ${v}이(가) 숨어 있어!`;
    const br=Math.floor(r/bh)*bh, bc=Math.floor(c/bw)*bw;
    for(let i=br;i<br+bh;i++)for(let j=bc;j<bc+bw;j++)
      if((i!==r||j!==c)&&given[i][j]===v) return `이 네모방에 벌써 ${v}이(가) 숨어 있어!`;
    return "이 칸엔 그 숫자가 들어갈 수 없어! 가로줄, 세로줄, 네모방을 다시 봐 봐!";
  }
  function checkDone(){
    for(let r=0;r<n;r++)for(let c=0;c<n;c++) if(given[r][c]!==solution[r][c]) return false;
    return true;
  }
  function inputNum(v){
    if(tCleared) return;
    if(!sel){ showFeedback("hint","먼저 빈칸을 눌러 줘!"); return; }
    const [r,c]=sel, cell=cellAt(r,c);
    if(cell.classList.contains("given")){ showFeedback("hint","그 칸은 처음부터 있던 단서야! 다른 빈칸을 골라 봐!"); return; }
    if(v===0){ // 지우기
      cell.textContent=""; given[r][c]=0; cell.classList.add("blank"); refreshMarks(); return;
    }
    if(given[r][c]===v){ return; }
    if(v===solution[r][c]&&!conflict(r,c,v)){
      cell.textContent=v; given[r][c]=v; cell.classList.remove("blank","wrong","hintflash");
      cell.classList.add("correct","pop");
      board.querySelectorAll(".cell").forEach(x=>{ if(x.textContent==String(v)) x.classList.add("same-num"); });
      if(checkDone()) trainClear(lv,hintsUsed);
      else showFeedback("ok","👍 맞았어! 계속 조사해 보자!");
    } else {
      if(wrongLock) return; wrongLock=true;
      cell.classList.add("wrong");
      setTimeout(()=>{ cell.classList.remove("wrong"); wrongLock=false; },700);
      showFeedback("no","🤔 "+conflictWhy(r,c,v));
    }
  }
  function conflict(r,c,v){
    for(let i=0;i<n;i++) if(given[r][i]===v||given[i][c]===v) return true;
    const br=Math.floor(r/bh)*bh, bc=Math.floor(c/bw)*bw;
    for(let i=br;i<br+bh;i++)for(let j=bc;j<bc+bw;j++) if(given[i][j]===v) return true;
    return false;
  }
  document.querySelectorAll("#numpad button").forEach(btn=>btn.onclick=()=>inputNum(+btn.dataset.n));
  document.getElementById("tmap-btn2").onclick=trainMap;
  document.onkeydown=e=>{
    if(!document.getElementById("numpad")) return;
    if(/^[1-9]$/.test(e.key)&&+e.key<=n) inputNum(+e.key);
    if(e.key==="Backspace"||e.key==="Delete"||e.key==="0") inputNum(0);
  };

  /* ---- 3단계 돋보기 힌트 ---- */
  document.getElementById("hint-btn").onclick=()=>{
    if(tCleared) return;
    hintsUsed++;
    hintStage=Math.min(hintStage+1,3);
    if(hintStage===1){
      // 빈칸이 하나만 남은 줄이나 네모방 찾기
      let found=null;
      for(let r=0;r<n&&!found;r++){ if(given[r].filter(v=>!v).length===1) found=`${r+1}번째 가로줄`; }
      for(let c=0;c<n&&!found;c++){ let z=0; for(let r=0;r<n;r++) if(!given[r][c]) z++; if(z===1) found=`${c+1}번째 세로줄`; }
      for(let br2=0;br2<n&&!found;br2+=bh)for(let bc2=0;bc2<n&&!found;bc2+=bw){
        let z=0; for(let i=br2;i<br2+bh;i++)for(let j=bc2;j<bc2+bw;j++) if(!given[i][j]) z++;
        if(z===1) found=`${br2+1}번째 줄 근처의 네모방`;
      }
      showFeedback("hint","🔍 "+(found?`「${found}」에 빈칸이 딱 하나만 남았어! 거기를 먼저 봐 봐!`
        :"빈칸이 하나만 남은 줄이나 네모방을 찾아 봐!"));
    } else if(hintStage===2){
      // 후보 1개 칸, 없으면 숨어있는 단일 후보 칸
      hintCell=findHintCell(given,n,bw,bh);
      if(hintCell){
        const cell=cellAt(hintCell[0],hintCell[1]);
        cell.classList.remove("hintflash"); void cell.offsetWidth; cell.classList.add("hintflash");
        showFeedback("hint","🔍 반짝이는 칸을 봐! 이 칸엔 들어갈 수 있는 숫자가 하나뿐이야! 어떤 숫자일까?");
      } else showFeedback("hint","🔍 가로줄, 세로줄, 네모방을 겹쳐서 살펴봐!");
    } else {
      if(!hintCell) hintCell=findHintCell(given,n,bw,bh);
      if(hintCell){
        showFeedback("hint",`🔍 반짝이던 칸의 정답은 「${solution[hintCell[0]][hintCell[1]]}」이야! 눌러서 채워 보자!`);
        const cell=cellAt(hintCell[0],hintCell[1]);
        cell.classList.remove("hintflash"); void cell.offsetWidth; cell.classList.add("hintflash");
      }
    }
  };
  function findHintCell(g,n2,bw2,bh2){
    const candOf=(r,c)=>{ const out=[]; for(let v=1;v<=n2;v++){
      let ok2=true;
      for(let i=0;i<n2&&ok2;i++) if(g[r][i]===v||g[i][c]===v) ok2=false;
      const br=Math.floor(r/bh2)*bh2, bc=Math.floor(c/bw2)*bw2;
      for(let i=br;i<br+bh2&&ok2;i++)for(let j=bc;j<bc+bw2;j++) if(g[i][j]===v){ok2=false;break;}
      if(ok2) out.push(v); } return out; };
    for(let r=0;r<n2;r++)for(let c=0;c<n2;c++) if(!g[r][c]&&candOf(r,c).length===1) return [r,c];
    // 숨어있는 단일 후보: 어떤 숫자가 어떤 네모방/줄에서 갈 곳이 하나뿐인 칸
    for(let r=0;r<n2;r++)for(let c=0;c<n2;c++) if(!g[r][c]){
      for(const v of candOf(r,c)){
        let cnt=0;
        for(let i=0;i<n2;i++) if(!g[r][i]&&candOf(r,i).includes(v)) cnt++;
        if(cnt===1) return [r,c];
      }
    }
    for(let r=0;r<n2;r++)for(let c=0;c<n2;c++) if(!g[r][c]) return [r,c];
    return null;
  }
}

function trainClear(lv,hintsUsed){
  if(tCleared) return; tCleared=true; // 연타해도 레벨이 두 번 넘어가지 않게
  const stars=hintsUsed===0?3:hintsUsed<=2?2:1;
  if(!trainState.cleared.includes(lv)) trainState.cleared.push(lv);
  if(!trainState.stars[lv]||trainState.stars[lv]<stars) trainState.stars[lv]=stars; // 더 높은 별이면 갱신
  if(lv===9) trainState.legendBadge=true;
  saveTrain(); renderTop();
  showFeedback("ok","🎉 사건 해결! 대단해!");
  const slot=document.getElementById("next-slot");
  slot.innerHTML=`<div class="center"><span class="stamp">사건 해결!</span>
    <p class="jua" style="font-size:1.8rem; color:#e8a13c; margin:8px">${"★".repeat(stars)}${"☆".repeat(3-stars)}</p>
    <p>힌트 사용 ${hintsUsed}번</p><br>
    <button class="big-btn" id="tnext-btn">${lv>=9?"👑 특별 임명장 받기!":"다음 사건!"}</button>
    <button class="big-btn" id="tmap-btn3" style="background:#8a9aa8; border-color:#5a6a78; margin-left:8px">🗺️ 지도로</button></div>`;
  document.getElementById("tmap-btn3").onclick=trainMap;
  document.getElementById("tnext-btn").onclick=()=>{ if(lv>=9) legendEnding(); else trainIntro(lv+1); };
}

function legendEnding(){
  renderTop();
  const today=new Date();
  const dateStr=`${today.getFullYear()}년 ${today.getMonth()+1}월 ${today.getDate()}일`;
  screen.innerHTML=`
    <h2 class="center">👑 전설의 탐정 탄생! 👑</h2>
    ${chiefSays(state.name+" 탐정! 9개의 사건을 모두 해결하다니… 정말 전설이야!")}
    <div class="center"><span class="stamp">전설 인정!</span></div>
    <div class="cert pop">
      <p class="jua" style="font-size:1.5rem">👑 전설의 탐정 임명장 👑</p><br>
      <p><b>${state.name} 탐정</b>은</p>
      <p>9개의 사건을 모두 해결하여</p>
      <p><b>전설의 탐정</b>으로 임명합니다!</p><br>
      <p>${dateStr}</p>
      <p>탐정 사무소 대장 탐정 🕵️ <span class="stamp" style="font-size:.9rem">인</span></p>
    </div>
    <div class="center pop" style="font-size:4rem">👑</div>
    <div class="center"><button class="big-btn" id="tmap-btn4">🗺️ 지도로 돌아가기</button></div>`;
  document.getElementById("tmap-btn4").onclick=trainMap;
}

loadTrain();
boot(); // 프로필 시스템 시작 (script 2에 정의, 훈련 상태 로드 후 실행)

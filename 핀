   detectiveSudokuCurrent  = 현재 활성 프로필 이름
   기존 키 detectiveSudoku / detectiveSudokuTrain 은 호환을 위해 삭제하지 않고 함께 갱신 */
let state = { name:"", mission:0, gold:[null,null,null,null], badgeIdx:0, clues:[], finished:false };
let profiles = {};
let currentProfile = "";
const FRESH_STATE = ()=>({ name:"", mission:0, gold:[null,null,null,null], badgeIdx:0, clues:[], finished:false });
const FRESH_TRAIN = ()=>({ cleared:[], stars:{}, legendBadge:false });
function loadProfiles(){ try{ const s=localStorage.getItem("detectiveSudokuProfiles");
  if(s){ const p=JSON.parse(s); if(p&&typeof p==="object"&&!Array.isArray(p)) profiles=p; } }catch(e){} }
function saveProfiles(){ try{ localStorage.setItem("detectiveSudokuProfiles", JSON.stringify(profiles)); }catch(e){} }
function save(){
  if(currentProfile){
    profiles[currentProfile]=profiles[currentProfile]||{};
    profiles[currentProfile].state=state;
    saveProfiles();
  }
  try{ localStorage.setItem("detectiveSudoku", JSON.stringify(state)); }catch(e){} // 구 버전 호환 유지
}
function escapeHTML(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;"); }
function uniqueName(nm){
  if(!profiles[nm]) return nm;
  let i=2;
  while(profiles[nm+" ("+i+")"]) i++;
  return nm+" ("+i+")"; // 같은 이름의 탐정이 있으면 (2), (3)... 자동으로 붙임
}
function applyProfile(name){
  currentProfile=name;
  const p=profiles[name]||{};
  state=Object.assign(FRESH_STATE(), p.state||{});
  state.name=name;
  trainState=Object.assign(FRESH_TRAIN(), p.train||{});
  try{ localStorage.setItem("detectiveSudokuCurrent", name); }catch(e){}
}
function migrateLegacy(){
  // 기존 단일 키 데이터가 있고 프로필이 하나도 없으면 첫 프로필로 자동 이사 (기존 키는 삭제하지 않음)
  if(Object.keys(profiles).length>0) return;
  let legacy=null; try{ const s=localStorage.getItem("detectiveSudoku"); if(s) legacy=JSON.parse(s); }catch(e){}
  if(!legacy||typeof legacy!=="object") return;
  let legacyTrain=null; try{ const s=localStorage.getItem("detectiveSudokuTrain"); if(s) legacyTrain=JSON.parse(s); }catch(e){}
  const nm=uniqueName(String(legacy.name||"").trim()||"꼬마");
  profiles[nm]={
    state:Object.assign(FRESH_STATE(), legacy, {name:nm}),
    train:(legacyTrain&&Array.isArray(legacyTrain.cleared))?legacyTrain:FRESH_TRAIN()
  };
  saveProfiles();
}
function resumeFor(st){
  renderTop();
  if(st.finished) ending();
  else missionIntro(); // 새 프로필(mission 0)은 1장 소개부터
}
let pendingDelete=null; // 삭제 2단계 확인용 (지금 확인 중인 프로필 이름)
function profileScreen(){
  renderTop();
  const names=Object.keys(profiles);
  let html=`<h1 class="center">🔎 사라진 숫자 보석 사건</h1>
    <p class="center jua" style="font-size:1.2rem; margin:8px 0">누가 탐정 놀이를 할까?</p>`;
  if(names.length===0){
    html+=`<div class="clue-card center">아직 탐정이 없어!<br>아래 버튼을 눌러 새 탐정을 만들어 보자!</div>`;
  } else {
    html+=names.map(nm=>{
      const p=profiles[nm]||{}, st=p.state||{}, tr=p.train||{};
      const b=badgeFor(st.mission>=10?10:(st.mission||0));
      const stars=Object.keys(tr.stars||{}).reduce((a,k)=>a+(tr.stars[k]||0),0);
      const missionTxt=st.finished?"사건 해결! 🎉":(st.mission>0?`미션 ${st.mission}/10 진행 중`:"이제 막 시작!");
      const delBtn = pendingDelete===nm
        ? `<button data-del="${escapeHTML(nm)}" style="background:#ffdada;border-color:#d33">정말 지울까?<br>한 번 더 눌러!</button>`
        : `<button data-del="${escapeHTML(nm)}" aria-label="${escapeHTML(nm)} 탐정 삭제" title="삭제">🗑️</button>`;
      return `<div class="clue-card">
        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap">
          <span style="font-size:2.2rem" aria-hidden="true">${b[1].split(" ")[0]}</span>
          <div style="flex:1; min-width:130px"><b class="jua" style="font-size:1.25rem">${escapeHTML(nm)} 탐정</b><br>
          <span style="font-size:.95rem">${b[1].split(" ")[1]} · ${missionTxt} · 훈련 ⭐${stars}개</span></div>
          ${delBtn}
        </div>
        <button class="big-btn" data-cont="${escapeHTML(nm)}" style="width:100%; margin-top:8px">▶ 이어하기</button>
      </div>`;
    }).join("");
  }
  html+=`<div class="center" style="margin-top:14px"><button class="big-btn" id="new-btn" style="background:#4caf6d; border-color:#2e7d43">➕ 새 탐정 시작</button></div>`;
  screen.innerHTML=html;
  document.getElementById("new-btn").onclick=startScreen;
  screen.querySelectorAll("[data-cont]").forEach(b=>b.onclick=()=>{
    pendingDelete=null;
    applyProfile(b.dataset.cont); resumeFor(state);
  });
  screen.querySelectorAll("[data-del]").forEach(b=>b.onclick=()=>{
    const nm=b.dataset.del;
    if(pendingDelete===nm){ // 2단계: 두 번째 클릭에서 진짜 삭제
      delete profiles[nm]; saveProfiles();
      if(currentProfile===nm){ currentProfile=""; try{ localStorage.removeItem("detectiveSudokuCurrent"); }catch(e){} }
      pendingDelete=null;
    } else pendingDelete=nm; // 1단계: 확인 문구로 변경
    profileScreen();
  });
}
function switchDetective(){
  save(); saveTrain(); // 현재 진행 저장 후 목록으로
  pendingDelete=null;
  profileScreen();
}
function badgeFor(m){ let b=BADGES[0]; for(const x of BADGES) if(m>=x[0]) b=x; return b; }

/* ================= 공통 UI ================= */
const screen = document.getElementById("screen");
function renderTop(){
  document.getElementById("det-name").textContent = state.name ? state.name+" 탐정" : "탐정";
  const b = badgeFor(state.mission>=10?10:state.mission);
  document.getElementById("badge").textContent = b[1];
  document.querySelectorAll(".gold-slot").forEach((el,i)=>{
    el.textContent = state.gold[i] ?? "?";
    el.classList.toggle("filled", state.gold[i]!=null);
  });
  const p = document.getElementById("progress");
  p.innerHTML="";
  for(let i=0;i<10;i++){ const d=document.createElement("div"); d.className="seg"+(i<state.mission?" done":""); p.appendChild(d); }
}
function chiefSays(t){ return `<div class="chief-speech">${CHIEF_SVG}<div class="bubble"><b>대장 탐정:</b> ${t}</div></div>`; }
function raccoonSays(t){ return `<div class="raccoon-speech">${RACCOON_SVG}<div class="bubble"><b>뒤죽박죽 너구리:</b> ${t}</div></div>`; }
function toolbarHTML(){ return `<div class="toolbar">
  <button id="hint-btn" aria-label="돋보기 힌트">🔍</button>
  <button id="notebook-btn">📓 탐정 수첩</button></div>`; }
function bindToolbar(m){
  document.getElementById("hint-btn").onclick=()=>showFeedback("hint","🔍 "+m.hint);
  document.getElementById("notebook-btn").onclick=openNotebook;
}
function showFeedback(kind,msg){
  if(cleared && kind!=="ok") return;
  const f=document.getElementById("feedback");
  if(!f) return;
  f.className="feedback "+kind; f.textContent=msg; f.focus?.();
}
function buildBoard(grid, opts={}){
  const b=document.createElement("div"); b.id="board";
  grid.forEach((row,r)=>row.forEach((v,c)=>{
    const d=document.createElement("div");
    d.className="cell"; d.dataset.r=r; d.dataset.c=c; d.tabIndex=0;
    d.setAttribute("role","button"); d.setAttribute("aria-label",(r+1)+"번째 줄 "+(c+1)+"번째 칸");
    if(v) d.textContent=v; else d.classList.add("blank");
    if(opts.marks){ const mk=opts.marks.find(m=>m[0]===r&&m[1]===c);
      if(mk){ d.classList.add("mark"); d.innerHTML=`<div><div style="font-size:.8rem">${mk[2]}</div><div>${v||""}</div></div>`; } }
    b.appendChild(d);
  }));
  return b;
}
</script>
<script>
"use strict";
/* ================= 화면들 ================= */
function startScreen(){
  screen.innerHTML = `
    <h1 class="center">🔎 사라진 숫자 보석 사건</h1>
    <div class="cert" style="text-align:left">
      <p class="jua" style="font-size:1.2rem">📜 사건 의뢰서</p><br>
      <p>꼬마 탐정에게!</p><br>
      <p>보석 상자에 있던 <b>숫자 보석</b>들이 사라졌어!
      범인은 숫자를 몰래 바꾸는 <b>뒤죽박죽 너구리</b>야.</p><br>
      <p>스도쿠 판에 숨겨진 숫자를 찾아서 너구리를 잡아 줘!
      황금 단서 4장을 모으면 <b>비밀번호</b>를 알 수 있어.</p><br>
      <p style="text-align:right">- 대장 탐정 🕵️</p>
    </div>
    <label for="name-input" class="jua">탐정 이름을 적어 줘!</label>
    <input type="text" id="name-input" maxlength="10" placeholder="예: 하은">
    <div class="center" style="margin-top:12px">
      <button class="big-btn" id="start-btn">사건 시작!</button>
    </div>`;
  const inp=document.getElementById("name-input");
  document.getElementById("start-btn").onclick=()=>{
    // 같은 이름의 탐정이 있으면 "(2)"를 붙여 새 프로필 생성
    const nm=uniqueName(inp.value.trim()||"꼬마");
    state=Object.assign(FRESH_STATE(),{name:nm});
    trainState=FRESH_TRAIN();
    currentProfile=nm;
    profiles[nm]={state:state, train:trainState};
    saveProfiles();
    try{ localStorage.setItem("detectiveSudokuCurrent", nm); }catch(e){}
    save(); saveTrain();
    missionIntro();
  };
  inp.focus();
  // 탐정 목록으로 돌아가기
  const backWrap=document.createElement("div");
  backWrap.className="center"; backWrap.style.marginTop="10px";
  backWrap.innerHTML=`<button id="back-list-btn" style="background:#e5e0d4; border-color:#b0a890">← 탐정 목록으로</button>`;
  screen.appendChild(backWrap);
  document.getElementById("back-list-btn").onclick=profileScreen;
}

function missionIntro(){
  renderTop();
  const m = MISSIONS[state.mission];
  screen.innerHTML = `
    <h2 class="center">${m.ch} - ${m.concept}</h2>
    ${chiefSays(m.chief.replace(/탐정/g,"")+" "+state.name+" 탐정!")}
    <div class="center"><button class="big-btn" id="go-btn">미션 시작!</button></div>
    <div class="toolbar"><button id="notebook-btn">📓 탐정 수첩</button></div>`;
  document.getElementById("go-btn").onclick=()=>runMission(m);
  document.getElementById("notebook-btn").onclick=openNotebook;
}

let cleared=false; // 정답 후 연타해도 미션이 두 번 넘어가지 않게
function runMission(m){
  cleared=false;
  renderTop();
  if(m.type==="quiz") return quizMission(m);
  if(m.type==="fill") return fillMission(m);
  if(m.type==="findwrong") return findWrongMission(m);
  if(m.type==="code") return codeMission(m);
}

function quizMission(m){
  screen.innerHTML = `<h2 class="center">${m.ch} O/X 퀴즈</h2>${chiefSays(m.chief)}
    <div class="bubble" style="font-size:1.15rem; margin:12px 0">❓ ${m.q}</div>
    <button class="choice" data-i="0">🙆 ${m.choices[0]}</button>
    <button class="choice" data-i="1">🙅 ${m.choices[1]}</button>
    <div id="feedback" class="feedback" tabindex="-1"></div>
    <div class="center" id="next-slot"></div>${toolbarHTML()}`;
  bindToolbar(m);
  document.querySelectorAll(".choice").forEach(btn=>btn.onclick=()=>{
    if(+btn.dataset.i===m.answer){ showFeedback("ok","🎉 "+m.ok); missionClear(m); }
    else showFeedback("no","🤔 "+m.no);
  });
}

function fillMission(m){
  // 보드 데이터를 4x4로 확장
  let grid;
  if(m.singleRow){ grid=[[...m.board[0]],[null,null,null,null],[null,null,null,null],[null,null,null,null]]; }
  else if(m.singleCol){ grid=m.board.map(r=>[r[0],null,null,null]); }
  else if(m.box2){ grid=[m.board[0].concat([null,null]), m.board[1].concat([null,null]), [null,null,null,null],[null,null,null,null]]; }
  else { grid=m.board.map(r=>r.slice()); }
  const solved={};
  screen.innerHTML = `<h2 class="center">${m.ch} ${m.concept}</h2>${chiefSays(m.chief)}
    <p class="center jua">빈칸을 누르고 숫자를 골라 봐!</p>
    <div id="board-slot"></div>
    <div id="numpad">${[1,2,3,4].map(n=>`<button data-n="${n}">${n}</button>`).join("")}</div>
    <div id="feedback" class="feedback" tabindex="-1"></div>
    <div class="center" id="next-slot"></div>${toolbarHTML()}`;
  bindToolbar(m);
  const opts={};
  if(m.goldenCell){ opts.marks=[[m.goldenCell[0],m.goldenCell[1],"★"]]; }
  const board=buildBoard(grid.map(r=>r.map(v=>v??0)),opts);
  // null 칸은 표시 안 함
  board.querySelectorAll(".cell").forEach(c=>{
    const r=+c.dataset.r, cc=+c.dataset.c;
    if(grid[r][cc]===null){ c.style.visibility="hidden"; c.tabIndex=-1; }
    if(!m.targets.some(t=>t[0]===r&&t[1]===cc)){ c.style.cursor="default"; }
  });
  document.getElementById("board-slot").appendChild(board);
  let sel=null;
  board.querySelectorAll(".cell").forEach(c=>{
    const act=()=>{
      const r=+c.dataset.r, cc=+c.dataset.c;
      if(!m.targets.some(t=>t[0]===r&&t[1]===cc)) return;
      board.querySelectorAll(".cell").forEach(x=>x.classList.remove("selected"));
      c.classList.add("selected"); sel=[r,cc];
    };
    c.onclick=act; c.onkeydown=e=>{ if(e.key==="Enter"||e.key===" "){e.preventDefault();act();} };
  });
  document.querySelectorAll("#numpad button").forEach(btn=>btn.onclick=()=>{
    if(!sel){ showFeedback("hint","먼저 빈칸을 눌러 줘!"); return; }
    const [r,cc]=sel, n=+btn.dataset.n;
    const answer=m.solution ? m.solution[r][cc] : expectedByRule(grid,r,cc,m);
    if(n===answer){
      const cell=board.querySelector(`[data-r="${r}"][data-c="${cc}"]`);
      cell.textContent=n; cell.classList.remove("selected","blank"); cell.classList.add("correct");
      solved[r+","+cc]=true;
      const left=m.targets.filter(t=>!solved[t[0]+","+t[1]]);
      if(left.length===0){ showFeedback("ok","🎉 "+m.ok); missionClear(m); }
      else showFeedback("ok","👍 맞았어! 남은 빈칸 "+left.length+"개!");
    } else showFeedback("no","🤔 "+m.no);
  });
}
function expectedByRule(grid,r,c,m){
  const nums=new Set();
  if(m.singleRow){ grid[r].forEach(v=>{if(v)nums.add(v);}); }
  else if(m.singleCol){ grid.forEach(row=>{if(row[c])nums.add(row[c]);}); }
  else if(m.box2){
    const br=Math.floor(r/2)*2, bc=Math.floor(c/2)*2;
    for(let i=br;i<br+2;i++)for(let j=bc;j<bc+2;j++){ if(grid[i]&&grid[i][j]) nums.add(grid[i][j]); }
  }
  for(let n=1;n<=4;n++) if(!nums.has(n)) return n;
  return null;
}

function findWrongMission(m){
  screen.innerHTML = `<h2 class="center">${m.ch} 틀린 칸 찾기</h2>${chiefSays(m.chief)}
    ${raccoonSays("히히~ 내가 숫자 하나를 바꿨지롱! 찾을 수 있겠어?")}
    <p class="center jua">너구리가 바꾼 칸을 눌러 봐!</p>
    <div id="board-slot"></div>
    <div id="feedback" class="feedback" tabindex="-1"></div>
    <div class="center" id="next-slot"></div>${toolbarHTML()}`;
  bindToolbar(m);
  const board=buildBoard(m.board);
  document.getElementById("board-slot").appendChild(board);
  board.querySelectorAll(".cell").forEach(c=>{
    const act=()=>{
      const r=+c.dataset.r, cc=+c.dataset.c;
      if(m.wrongCells.some(w=>w[0]===r&&w[1]===cc)){
        if(cleared) return;
        c.classList.add("wrong");
        setTimeout(()=>{ c.textContent=m.fixTo; c.classList.remove("wrong"); c.classList.add("correct","pop"); },900);
        showFeedback("ok","🎉 "+m.ok); missionClear(m);
      } else if(!cleared) { c.classList.add("correct"); setTimeout(()=>c.classList.remove("correct"),600); showFeedback("no","🤔 "+m.no); }
    };
    c.onclick=act; c.onkeydown=e=>{ if(e.key==="Enter"||e.key===" "){e.preventDefault();act();} };
  });
}

function codeMission(m){
  screen.innerHTML = `<h2 class="center">${m.ch} 암호 쪽지</h2>${chiefSays(m.chief)}
    ${raccoonSays("이 쪽지를 읽을 수 있을까~? ♥와 ★를 순서대로 읽어 봐!")}
    <div id="board-slot"></div>
    <div class="bubble" style="margin:10px 0">${m.q}</div>
    <div id="numpad">${[1,2,3,4].map(n=>`<button data-n="${n}">${n}</button>`).join("")}</div>
    <p class="center jua" id="code-display" style="font-size:2rem; letter-spacing:8px">__</p>
    <div id="feedback" class="feedback" tabindex="-1"></div>
    <div class="center" id="next-slot"></div>${toolbarHTML()}`;
  bindToolbar(m);
  const board=buildBoard(m.board,{marks:m.marks});
  document.getElementById("board-slot").appendChild(board);
  let typed="";
  document.querySelectorAll("#numpad button").forEach(btn=>btn.onclick=()=>{
    if(typed.length>=2) return;
    typed+=btn.dataset.n;
    document.getElementById("code-display").textContent=typed.padEnd(2,"_");
    if(typed.length===2){
      if(typed===m.answer){ showFeedback("ok","🎉 "+m.ok); missionClear(m); }
      else { showFeedback("no","🤔 "+m.no); typed=""; setTimeout(()=>document.getElementById("code-display").textContent="__",800); }
    }
  });
}

function missionClear(m){
  if(cleared) return; cleared=true;
  const num=state.mission+1;
  if(m.golden!=null && state.gold[m.golden]==null){
    state.gold[m.golden]=GOLDEN[m.golden];
    state.clues.push(`황금 단서 ${m.golden+1}번: 숫자 ${GOLDEN[m.golden]} (${m.ch})`);
  } else {
    state.clues.push(`${m.ch} 단서 카드: ${m.concept} - ${m.ok.split("!")[0]}!`);
  }
  state.mission=num; save();
  const slot=document.getElementById("next-slot");
  slot.innerHTML=`<div class="clue-card pop ${m.golden!=null?"golden":""}">
    🃏 <b>${m.golden!=null?"황금 단서 카드 "+(m.golden+1)+"번: 숫자 "+GOLDEN[m.golden]:"단서 카드 획득!"}</b></div>
    <span class="stamp">해결!</span><br><br>
    <button class="big-btn" id="next-btn">${num>=10?"범인을 잡으러 가자!":"다음 미션!"}</button>`;
  document.getElementById("next-btn").onclick=()=>{
    if(num===3||num===7) badgeUp(num);
    else if(num>=10) ending();
    else missionIntro();
  };
  renderTop();
}

function badgeUp(missionNum){
  renderTop();
  const b=badgeFor(missionNum);
  screen.innerHTML=`<div class="center">
    <h2>🎊 배지 승급! 🎊</h2>
    <div class="pop" style="font-size:5rem; margin:20px">${b[1].split(" ")[0]}</div>
    <p class="jua" style="font-size:1.5rem">${state.name} 탐정은 이제<br>「${b[1].split(" ")[1]}」!</p>
    ${chiefSays("축하해 "+state.name+" 탐정! 정말 대단해!")}
    <button class="big-btn" id="cont-btn">계속하기</button></div>`;
  document.getElementById("cont-btn").onclick=missionIntro;
}

function ending(){
  renderTop(); state.finished=true; save();
  const today=new Date();
  const dateStr=`${today.getFullYear()}년 ${today.getMonth()+1}월 ${today.getDate()}일`;
  screen.innerHTML=`
    <h2 class="center">🚨 범인 체포! 🚨</h2>
    ${raccoonSays("들켰다! 미안해… 숫자 보석은 여기 있어. 장난이 너무 심했지? 앞으로는 착한 너구리가 될게! 우리 친구하자!")}
    ${chiefSays(state.name+" 탐정, 정말 훌륭했어! 숫자 보석을 모두 찾았어!")}
    <div class="center"><span class="stamp">사건 해결!</span></div>
    <div class="cert pop">
      <p class="jua" style="font-size:1.5rem">👑 명탐정 임명장 👑</p><br>
      <p><b>${state.name} 탐정</b>은</p>
